# Required
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocodejs_auth
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-a-different-32-byte-random-secret

WEB_ORIGINS=http://localhost:3000,http://localhost:5173
APP_BASE_URL=http://localhost:3000
COOKIE_DOMAIN=
SESSION_TTL_SECONDS=604800

# SMTP is required in production; development logs verification/reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
