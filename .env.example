# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ocodejs_auth

# Generate two different random secrets, each at least 32 characters.
SESSION_SECRET=replace-with-at-least-32-random-bytes
CSRF_SECRET=replace-with-a-different-32-byte-random-secret

# Public frontend URL used in verification and password-reset links.
APP_BASE_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_DOMAIN=
SESSION_TTL_SECONDS=604800

# Keep at 0 unless Velclawhost's trusted reverse-proxy hop count is known.
TRUST_PROXY_HOPS=0

# SMTP is mandatory in production. Without SMTP, development logs links to server output.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
